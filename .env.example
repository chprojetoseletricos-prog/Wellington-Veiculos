# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Somente no servidor. Nunca use prefixo NEXT_PUBLIC_ nesta chave.
SUPABASE_SECRET_KEY=

# Alternativas legadas, necessárias apenas em projetos antigos:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# URL pública, sem barra no final. Em desenvolvimento: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
